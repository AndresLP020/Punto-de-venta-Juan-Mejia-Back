#PORT=4000
#NODE_ENV=development

# Local (Compass)
#MONGODB_URI=mongodb://localhost:27017/pos

# Producción (Render): pega la URI de Atlas. Obligatoria o el servicio se cae.
#MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/pos?retryWrites=true&w=majority

# URL del frontend en Render (CORS). Puedes poner varias separadas por coma.
#FRONT_URL=https://tu-front.onrender.com

# ---------------------------------------------------------------------------
# Seguridad (OBLIGATORIAS en producción)
# ---------------------------------------------------------------------------

# Clave para firmar las sesiones. Usa un texto largo y aleatorio, por ejemplo el resultado de:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si no la defines se genera una al arrancar y todas las sesiones se cierran en cada reinicio.
#AUTH_SECRET=

# Usuario principal (acceso con todos los permisos). En producción, si LOGIN_PASSWORD no está
# definido, este usuario queda deshabilitado. En desarrollo el valor por defecto es admin / juanmejia123.
#LOGIN_USER=admin
#LOGIN_PASSWORD=

# Contraseña del modo administrador (Dashboard → "Modo administrador").
# En producción es obligatoria; en desarrollo la contraseña por defecto es: admin
#ADMIN_PASSWORD=

# Zona horaria del negocio (para semanas de nómina y fechas del día).
#APP_TZ=America/Mexico_City

# Impresora térmica local (Windows). Por defecto POS-80.
#PRINTER_NAME=POS-80
