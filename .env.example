#PORT=4000
#NODE_ENV=development

# MongoDB (Compass local)
#MONGODB_URI=mongodb://localhost:27017/pos

# Contraseña del modo administrador (Dashboard → "Modo administrador").
# Si no la defines, en desarrollo la contraseña por defecto es: admin
#ADMIN_PASSWORD=admin

# URL del frontend (para CORS y para las URLs de retorno de las pasarelas).
# Sin barra final. En Render usa la URL de Vercel, p. ej.:
# FRONT_URL=https://punto-de-venta-juan-mejia-front-n9n.vercel.app
#FRONT_URL=http://localhost:3000

# URL pública del backend (para el webhook/IPN de Mercado Pago). En local usa un túnel (ngrok).
#PUBLIC_API_URL=https://tu-backend.publico

# Moneda de los pagos (código ISO). Por defecto: mxn
#CURRENCY=mxn

# Número de WhatsApp que recibe pedidos y comprobantes (formato internacional sin +)
#WHATSAPP_NUMBER=527121537999

# ---------------------------------------------------------------------------
# DATOS BANCARIOS para pagos por TRANSFERENCIA (rellénalos con los tuyos)
# ---------------------------------------------------------------------------
#BANK_HOLDER=Andres Lopez Piña
#BANK_NAME=Mercado Pago
#BANK_ACCOUNT=5428785233937142
#BANK_CLABE=
#BANK_CARD=5428785233937142

# ---------------------------------------------------------------------------
# STRIPE (tarjeta). Consíguelas en https://dashboard.stripe.com/apikeys
# En producción usa claves sk_live / pk_live y FRONT_URL con tu dominio público.
# Webhook (modo live): Developers → Webhooks → Add endpoint
#   URL: https://TU-API-PUBLICA/api/pagos/stripe/webhook
#   Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
# ---------------------------------------------------------------------------
#STRIPE_SECRET_KEY=sk_test_xxx
#STRIPE_PUBLISHABLE_KEY=pk_test_xxx
#STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------------------------------------------------------------------------
# MERCADO PAGO. Access token en https://www.mercadopago.com.mx/developers/panel
# ---------------------------------------------------------------------------
#MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
